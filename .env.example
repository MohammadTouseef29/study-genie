GROQ_API_KEY=your_groq_api_key_here
STUDY_GENIE_API_URL=http://localhost:8000

# Supabase Postgres connection string. Use the "Connection pooling" URI
# (Project Settings -> Database -> Connection pooling), not the direct connection --
# the direct host is often IPv6-only. Fill in your real password locally in .env.
DATABASE_URL=postgresql://postgres.your-project-ref:your_password_here@aws-region.pooler.supabase.com:5432/postgres

# Supabase project URL and service role key (Project Settings -> API).
# The service role key bypasses Row Level Security -- used by the backend only,
# never expose it to the frontend/browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
